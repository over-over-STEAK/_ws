def rgb_to_hex(rgb):
    return '#%02x%02x%02x' % rgb

red = rgb_to_hex((255, 0, 0))

def get_news(num=10):
    all_news = []
    pid = ''
    while len(all_news) < num:
        url = f'https://www.nownews.com/nn-client/api/v1/cat/breaking/?pid={pid}'
        r = requests.get(url, headers=HEADERS)
        if r.status_code != requests.codes.ok:
            print(f'Requests Error: {r.status_code}')
            break

        data = r.json()
        news_list = data['data']['newsList']

        for news in news_list:
            news_data = {
                'id': news['id'],
                'url': 'https://www.nownews.com' + news['postOnlyUrl'],
                'title': news['postTitle'],
                'content': news['postContent'],
                'date': news['newsDate']
            }
            all_news.append(news_data)

        pid = all_news[-1]['id']
        time.sleep(random.uniform(2, 5))

    return all_news

def show_weather():
    clear_frame()
    frame.config(bg='#FFEFDB')
    my_font = ('Arial', 20)

    url = 'https://weather.com/zh-TW/weather/tenday/l/Panshan+Kinmen+County?canonicalCityId=24a1edccf467769fec86a4f2c3afd27edf669009a3355d5082ce946b26a08d3f'
    response = requests.get(url)

    soup = BeautifulSoup(response.text, 'lxml')

    titles = soup.find_all('span')
    allInf = soup.find_all('p', class_='DailyContent--narrative--3Ti6_')
    weather_info = titles[19].text
    weather_infor = allInf[0].text
    tk.Label(frame, text=weather_infor, font=my_font, padx=0, pady=10, bg='#FFEFDB').pack(side=tk.LEFT)
    threading.Thread(target=speak_text, args=(weather_infor,)).start()

def show_nba():
    clear_frame()
    frame.config(bg='#FFEFDB')
    my_font = ('Arial', 20)

    url = 'https://tw-nba.udn.com/nba/team_tab/583ec825-fb46-11e1-82cb-f4ce4684ea4c'
    response = requests.get(url)

    soup = BeautifulSoup(response.text, 'lxml')

    titles = soup.find_all('div')
    team = soup.find_all('div', class_='team_score_team')
    score = soup.find_all('div', class_='team_score_score')
    date = soup.find_all('div', class_='team_score_date')

    speech_text = ""  

    for i in range(3):
        date_text = date[i].text
        team_text = f"勇士 VS {team[i].text} {score[i].text}"

        date_label = tk.Label(frame, text=date_text, font=my_font, bg='#FFEFDB')
        date_label.grid(row=i, column=0, padx=10, pady=10)
        game_label = tk.Label(frame, text=team_text, font=my_font, bg='#FFEFDB')
        game_label.grid(row=i, column=1, padx=10, pady=10)

        separator_label = tk.Label(frame, text="", font=my_font, height=1, bg='#FFEFDB')
        separator_label.grid(row=i, column=2)

        speech_text += date_text + " " + team_text + " "  

    threading.Thread(target=speak_text, args=(speech_text,)).start()

def speak_text(text):
    engine = pyttsx3.init()
    engine.say(text)
    engine.runAndWait()


        

def show_exchange_rate():
    clear_frame()
    my_font = ('Arial', 20)

    url = 'https://rate.bot.com.tw/xrt/quote/l6m/USD'
    exchange_rate = requests.get(url)
    sp = BeautifulSoup(exchange_rate.text, 'html.parser')
    table = sp.find('table', {'title': '歷史本行營業時間牌告匯率'})


    if table:
       rows = table.find_all('tr')
       data_rows = rows[2:5]

       data_str = "\n".join("  ".join(row.stripped_strings) for row in data_rows)

       table_str = f"{data_str}"
       table_label = tk.Label(frame, text=table_str, font=my_font, bg='#FFEFDB')
       table_label.pack()
       frame.config(bg='#FFEFDB')

