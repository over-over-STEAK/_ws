# 導入Discord.py模組
import discord
import compiler

# client是跟discord連接，intents是要求機器人的權限
intents = discord.Intents.default()
intents.message_content = True
client = discord.Client(intents = intents)

# 調用event函式庫
@client.event
# 當機器人完成啟動
async def on_ready():
    print(f"目前登入身份 --> {client.user}")

min = 0
max = 100
target = 0

@client.event
# 當頻道有新訊息
async def on_message(message):
    global target , min , max
    # 排除機器人本身的訊息，避免無限循環
    if message.author == client.user:
        return
    # 新訊息包含Hello，回覆Hello, world!
    if message.content == "Hello":
        await message.channel.send("Hello, world!")
    text = message.content.split()

    if text[0] == "比大小":
        if text[1] == "開始":
            target = compiler.start(0,100)
            min = 0
            max = 100
            await message.channel.send("初始化已完成")
            print(target)
            print(type(target))
        else:
            match(compiler.compare(target , int(text[1]) , min , max)):
                case -1:
                    await message.channel.send(f"輸入錯誤，請重新輸入 {min}~{max}")
                case 0:
                    await message.channel.send(f"恭喜你答對嘍，答案是{target}")
                case 1:
                    max = int(text[1])
                    await message.channel.send(f"太大嘍，介於{min}~{max}")
                case 2:
                    min = int(text[1])
                    await message.channel.send(f"太小嘍，介於{min}~{max}")

    

